# 앱 ↔ 서버 인증 토큰 (앱 Config.kt의 APP_TOKEN과 동일하게)
APP_TOKEN=change-me

# echo | anthropic | openai_compat
VLM_PROVIDER=echo
VLM_MODEL=claude-sonnet-5-5
VLM_MAX_TOKENS=400

# VLM_PROVIDER=anthropic 일 때
ANTHROPIC_API_KEY=

# VLM_PROVIDER=openai_compat 일 때 (OpenAI / 자체 vLLM / Ollama)
# 예) 자체 GPU 서버 vLLM:  OPENAI_BASE_URL=http://10.0.0.20:8000/v1  VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# 예) Ollama:              OPENAI_BASE_URL=http://localhost:11434/v1  VLM_MODEL=qwen2.5vl
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

HISTORY_TURNS=6
SESSION_TTL_SEC=900
